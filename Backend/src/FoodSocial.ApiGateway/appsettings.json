      "Default": {
        "PermitLimit": 300,
        "WindowSeconds": 60
      },
      "Auth": {
        "PermitLimit": 30,
        "WindowSeconds": 60
      },
      "RiskyWrite": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      },
      "MediaUpload": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      }
    }
  }
}
