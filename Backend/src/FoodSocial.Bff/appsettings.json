{
  "Authentication": {
    "RequireHttpsMetadata": true
  },
  "Keycloak": {
    "Authority": "",
    "Audience": "foodsocial-api",
    "Realm": "foodsocial",
    "BffClientId": "foodsocial-bff",
    "BffClientSecret": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Recommendations": {
    "AiEnabled": false,
    "DefaultLimit": 10,
    "MaxLimit": 25,
    "ProviderTimeoutMilliseconds": 750
  },
  "RateLimiting": {
    "Enabled": true,
    "Default": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "RiskyWrite": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "MediaUpload": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "SearchAssist": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
